#Postgresql DB - Master
CLIENT_DB_HOST=postgresql
CLIENT_DB_USERNAME=root
CLIENT_DB_PASSWORD=root
CLIENT_DB_PORT=5432
CLIENT_DB_DATABASE=client

#Postgresql DB - Slave
CLIENT_DB_HOST_SLAVE=
CLIENT_DB_USERNAME_SLAVE=
CLIENT_DB_PASSWORD_SLAVE=
CLIENT_DB_PORT_SLAVE=
CLIENT_DB_DATABASE_SLAVE=

# API keys
API_KEY=dev-api-key

#RabbitMQ
RABBITMQ_URL=amqp://root:root@rabbitmq:5672/

# Other
WEBHOOK_TIMEOUT_SECONDS=10
